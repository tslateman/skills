+def _is_due(subscription, today):
+    return subscription.status == "active" and subscription.renews_on <= today
+
+
+def _within_grace(subscription, today):
+    return today - subscription.renews_on <= timedelta(days=GRACE_PERIOD_DAYS)
+
+
+def renew(subscription, today):
+    if not _is_due(subscription, today):
+        return subscription
+
+    if subscription.payment_method is None:
+        subscription.status = "past_due"
+        return subscription
+
+    if subscription.trial_ends_on and subscription.trial_ends_on > today:
+        return subscription
+
+    if charge(subscription.payment_method, subscription.price):
+        subscription.renews_on = today + timedelta(days=30)
+        return subscription
+
+    subscription.status = (
+        "past_due" if _within_grace(subscription, today) else "canceled"
+    )
+    return subscription
